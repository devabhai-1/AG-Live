{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/((?!privacy-policy|terms-and-conditions|account-deletion|about-us|contact-us|assets|sitemap\\.xml|robots\\.txt|CNAME).*)",
      "destination": "/index.html"
    }
  ]
}
